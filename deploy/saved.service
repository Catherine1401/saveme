[Unit]
Description=saveme commitment daemon
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/libexec/saved -config /etc/saveme/config.json
User=root
Restart=always
RestartSec=1
UMask=0077
KillMode=control-group
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/saveme /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_LINUX_IMMUTABLE CAP_CHOWN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=CAP_SETUID
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target

[Unit]
Description=saveme automatic update helper
Wants=network-online.target
After=network-online.target saved.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/saveme/helper -config /etc/saveme/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
